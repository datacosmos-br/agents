# Generated by `make gen` from tools/templates/agents.envrc.
# The portable project identity is generated from config/beads.yaml and
# .beads/identity.toml; Gas City alone publishes the live server endpoint.
strict_env
watch_file "$HOME/.config/environment.d/projects/agent-tools.envrc"
source_env "$HOME/.config/environment.d/projects/agent-tools.envrc"

checkout_root="$(pwd -P)"
: "${AGENTS_GAS_CITY_ROOT:?AGENTS_GAS_CITY_ROOT must name the canonical Gas City checkout}"
gas_city_root="$(cd "${AGENTS_GAS_CITY_ROOT}" && pwd -P)"
if [[ ! -d "$checkout_root/.beads" || -L "$checkout_root/.beads" ]]; then
  log_error "Beads identity must be a physical checkout directory"
  return 1
fi
chmod 700 "$checkout_root/.beads" || return $?
unset GT_ROOT
unset GT_TOWN_ROOT
unset BEADS_DIR
unset BEADS_DOLT_PORT
unset BEADS_DOLT_DATA_DIR
unset BEADS_DOLT_SHARED_SERVER
unset BEADS_DOLT_SERVER_HOST
unset BEADS_DOLT_SERVER_PORT
unset BEADS_DOLT_SERVER_DATABASE
watch_file "$checkout_root/.beads/metadata.json"
watch_file "$gas_city_root/city.toml"
watch_file "$gas_city_root/.gc/runtime/packs/dolt/dolt-state.json"

if metadata_route="$(
  jq -er 'if (.backend | type == "string" and length > 0) and
    (.dolt_database | type == "string" and length > 0) and
    (.dolt_mode | type == "string" and length > 0) then
    [.backend, .dolt_database, .dolt_mode] | @tsv
  else
    error("this workspace has no valid Beads metadata route")
  end' "$checkout_root/.beads/metadata.json"
)"; then
  IFS=$'\t' read -r beads_backend server_database beads_mode <<< "$metadata_route"
else
  return $?
fi
if city_context="$(mise exec -- gc bd --city "$gas_city_root" context --json)"; then
  :
else
  return $?
fi
if city_endpoint="$(
  jq -er --arg root "$gas_city_root" --arg backend "$beads_backend" \
    --arg mode "$beads_mode" '
    if .schema_version == 1 and .repo_root == $root and
      .beads_dir == ($root + "/.beads") and .is_worktree == false and
      .is_redirected == false and (.role | type == "string" and length > 0) and
      (.database | type == "string" and length > 0) and
      .backend == $backend and .dolt_mode == $mode and
      (.server_host | type == "string" and length > 0 and
        (contains("\t") | not) and (contains("\n") | not)) and
      (.server_port | type == "number" and . == floor and . > 0 and . < 65536) then
      [.server_host, (.server_port | tostring)] | @tsv
  else
      error("Gas City Beads context has no valid managed endpoint")
    end' <<< "$city_context"
)"; then
  IFS=$'\t' read -r server_host server_port <<< "$city_endpoint"
else
  return $?
fi
export BEADS_DOLT_SERVER_HOST="$server_host"
export BEADS_DOLT_SERVER_PORT="$server_port"
export BEADS_DOLT_SERVER_DATABASE="$server_database"
