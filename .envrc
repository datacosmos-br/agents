strict_env
watch_file "$HOME/.config/environment.d/projects/agent-tools.envrc"
source_env "$HOME/.config/environment.d/projects/agent-tools.envrc"

checkout_root="${DIRENV_DIR#-}"
checkout_root="$(cd "$checkout_root" && pwd -P)"
: "${AGENTS_GAS_CITY_ROOT:?AGENTS_GAS_CITY_ROOT must name the canonical Gas City checkout}"
gas_city_root="$(cd "$AGENTS_GAS_CITY_ROOT" && pwd -P)"

watch_file "$checkout_root/.beads/metadata.json"
watch_file "$gas_city_root/.gc/runtime/packs/dolt/dolt-state.json"

unset GT_ROOT GT_TOWN_ROOT
unset BEADS_DIR BEADS_DOLT_PORT BEADS_DOLT_DATA_DIR BEADS_DOLT_SHARED_SERVER

# Keep this repository's Beads identity/database while using Gas City's single
# managed Dolt server. Its runtime publication is the only port authority.
export BEADS_DOLT_SERVER_HOST=127.0.0.1
export BEADS_DOLT_SERVER_PORT="$(
  jq -r 'if .running == true and (.port | type == "number") and .port > 0 then
    .port
  else
    error("Gas City managed Dolt state is not healthy")
  end' "$gas_city_root/.gc/runtime/packs/dolt/dolt-state.json"
)"
export BEADS_DOLT_SERVER_DATABASE="$(
  jq -r 'if .dolt_database != null and .dolt_database != "" then
    .dolt_database
  else
    error("this checkout has no Beads dolt_database identity")
  end' "$checkout_root/.beads/metadata.json"
)"
