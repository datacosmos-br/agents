{
  "_comment": "Canonical agents-owned MCP definitions; physical projections only; ECC excluded.",
  "mcb": {
    "command": "/home/marlonsc/.local/bin/mcb",
    "args": ["serve", "--stdio"],
    "type": "stdio",
    "env": {
      "MCB_CONFIG_FOLDER": "/home/marlonsc/cosmos-main/.state/mcb/config",
      "MCP__PROVIDERS__EMBEDDING__PROVIDER": "ollama",
      "MCP__PROVIDERS__EMBEDDING__MODEL": "nomic-embed-text",
      "MCP__PROVIDERS__EMBEDDING__OLLAMA__BASE_URL": "http://localhost:11434",
      "MCP__PROVIDERS__VECTOR_STORE__PROVIDER": "edgevec",
      "MCP__PROVIDERS__VECTOR_STORE__COLLECTION": "cosmos-main",
      "MCP__PROVIDERS__VECTOR_STORE__DIMENSIONS": "768"
    },
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "Semantic code search using embeddings and vector store",
    "source": "local",
    "enabled": false,
    "cwd": "/home/marlonsc/cosmos-main"
  },
  "context7": {
    "command": "npx",
    "args": ["-y", "@upstash/context7-mcp@latest"],
    "type": "stdio",
    "env": {
      "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
    },
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "Library documentation and code examples lookup",
    "source": "npm",
    "enabled": true
  },
  "sequential-thinking": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
    "type": "stdio",
    "env": {
      "DISABLE_THOUGHT_LOGGING": "true"
    },
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "Complex problem solving with step-by-step reasoning",
    "source": "npm",
    "enabled": true
  },
  "ast-grep": {
    "command": "uvx",
    "args": ["--from", "git+https://github.com/ast-grep/ast-grep-mcp", "ast-grep-server"],
    "type": "stdio",
    "env": {},
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "AST-based code search and structural pattern matching",
    "source": "github",
    "enabled": true
  },
  "repomix": {
    "command": "bash",
    "args": ["-c", "exec node \"$MCP_REPOMIX_BIN\" --mcp"],
    "type": "stdio",
    "env": {},
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "AI-optimized codebase analysis and packing",
    "source": "local",
    "enabled": true
  },
  "mcp-python-refactoring": {
    "command": "uvx",
    "args": ["--from", "/home/marlonsc/mcp-python-refactoring", "python-refactor", "server"],
    "type": "stdio",
    "env": {},
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "Python refactoring analysis with Vulture, Rope, Refurb, Complexipy",
    "source": "local",
    "enabled": false
  },
  "aider-mcp": {
    "command": "aider",
    "args": ["--mcp"],
    "type": "stdio",
    "env": {},
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "MCP bridge server for Aider integration",
    "source": "pip",
    "enabled": true
  },
  "claude-mem": {
    "command": "/home/marlonsc/claude-mem/plugin/scripts/mcp-server.cjs",
    "args": [],
    "type": "stdio",
    "env": {},
    "compatibility": ["claude", "gemini", "cursor", "codex", "opencode", "aider", "kimi"],
    "description": "Claude-Mem memory search MCP server",
    "source": "local",
    "enabled": false
  },
  "serena": {
    "command": "uvx",
    "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context", "claude-code", "--project-from-cwd"],
    "type": "stdio",
    "env": {},
    "compatibility": ["kimi", "claude", "codex", "cursor", "gemini", "opencode", "aider"],
    "description": "Symbolic code analysis and navigation with Serena",
    "source": "github",
    "enabled": true
  }
}
