{
  "version": 3,
  "surfaces": {
    "rules": {
      "personal": {"entries": ["security"]},
      "project_generic": {"entries": []}
    }
  },
  "personal_targets": {
    "claude": {"skills": "${HOME}/.claude/skills", "commands": {"provider": "claude", "path": "${HOME}/.claude/commands"}, "rules": "${HOME}/.claude/rules"},
    "codex": {"skills": "${HOME}/.codex/skills", "rules": "${HOME}/.codex/rules"},
    "cursor": {"skills": "${HOME}/.cursor/skills"},
    "gemini": {"skills": "${HOME}/.gemini/skills", "commands": {"provider": "gemini", "path": "${HOME}/.gemini/commands"}},
    "opencode": {"skills": "${HOME}/.config/opencode/skills", "commands": {"provider": "opencode", "path": "${HOME}/.config/opencode/commands"}},
    "copilot": {"skills": "${HOME}/.copilot/skills", "commands": {"provider": "copilot", "path": "${HOME}/.claude/commands"}},
    "antigravity": {"skills": "${HOME}/.gemini/antigravity/skills"}
  },
  "projects": {
    "skills_path": ".agents/skills",
    "command_targets": {
      "claude": {"path": ".claude/commands"},
      "copilot": {"path": ".claude/commands"},
      "cursor": {"path": ".cursor/commands"},
      "gemini": {"path": ".gemini/commands"},
      "opencode": {"path": ".opencode/commands"}
    },
    "rules_path": ".agents/rules"
  }
}
