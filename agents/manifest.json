{
  "version": "1.0.0",
  "agents": {
    "executor": {
      "role": "Implementer",
      "triggers": [
        "write code",
        "implement feature",
        "fix bug",
        "refactor"
      ],
      "model": "ai-hub-primary",
      "summary": "Executes coding tasks with tests and validation."
    },
    "debugger": {
      "role": "Debugger",
      "triggers": [
        "debug",
        "test failure",
        "unexpected behavior",
        "error log"
      ],
      "model": "ai-hub-primary",
      "summary": "Diagnoses root causes and proposes minimal fixes."
    },
    "principal-software-engineer": {
      "role": "Architect",
      "triggers": [
        "design",
        "architecture",
        "plan",
        "review design"
      ],
      "model": "ai-hub-primary",
      "summary": "Designs systems and reviews architecture."
    },
    "blueprint-mode": {
      "role": "Planner",
      "triggers": [
        "brainstorm",
        "spec",
        "requirements",
        "plan feature"
      ],
      "model": "ai-hub-primary",
      "summary": "Produces detailed implementation plans."
    },
    "software-engineer": {
      "role": "General Engineer",
      "triggers": [
        "general coding",
        "explore codebase",
        "minor change"
      ],
      "model": "ai-hub-primary",
      "summary": "General-purpose engineering tasks."
    },
    "devops-expert": {
      "role": "DevOps/SRE",
      "triggers": [
        "kubernetes",
        "argocd",
        "terraform",
        "infrastructure",
        "deploy"
      ],
      "model": "ai-hub-primary",
      "summary": "Infrastructure, GitOps and platform tasks."
    },
    "platform-sre-kubernetes": {
      "role": "Kubernetes SRE",
      "triggers": [
        "k8s",
        "cluster",
        "helm",
        "operator"
      ],
      "model": "ai-hub-primary",
      "summary": "Kubernetes-specific SRE work."
    },
    "prompt-engineer": {
      "role": "Prompt Engineer",
      "triggers": [
        "prompt",
        "system prompt",
        "skill",
        "agent prompt"
      ],
      "model": "ai-hub-primary",
      "summary": "Improves prompts and agent instructions."
    },
    "janitor": {
      "role": "Refactorer",
      "triggers": [
        "cleanup",
        "lint",
        "format",
        "dead code",
        "canonicalize"
      ],
      "model": "ai-hub-primary",
      "summary": "Keeps codebase clean and canonical."
    },
    "playwright-tester": {
      "role": "Browser Tester",
      "triggers": [
        "browser test",
        "playwright",
        "e2e"
      ],
      "model": "ai-hub-primary",
      "summary": "Writes and runs browser-based tests."
    },
    "tdd-red": {
      "role": "TDD - Write Failing Test",
      "triggers": [
        "tdd",
        "write failing test"
      ],
      "model": "ai-hub-primary",
      "summary": "Produces a failing test before implementation."
    },
    "tdd-green": {
      "role": "TDD - Make Test Pass",
      "triggers": [
        "make test pass",
        "tdd implementation"
      ],
      "model": "ai-hub-primary",
      "summary": "Implements minimal code to pass the test."
    },
    "tdd-refactor": {
      "role": "TDD - Refactor",
      "triggers": [
        "refactor after green",
        "tdd refactor"
      ],
      "model": "ai-hub-primary",
      "summary": "Refactors while keeping tests green."
    },
    "dispatcher": {
      "role": "Dispatcher",
      "triggers": [
        "delegate",
        "route",
        "choose agent",
        "which agent"
      ],
      "model": "ai-hub-primary",
      "summary": "Routes tasks to the most appropriate specialized agent."
    },
    "code-reviewer": {
      "role": "Code Reviewer",
      "triggers": [
        "review",
        "code review",
        "pr review",
        "quality"
      ],
      "model": "ai-hub-primary",
      "summary": "Proactive code quality/security/maintainability review."
    },
    "security-reviewer": {
      "role": "Security Reviewer",
      "triggers": [
        "security",
        "vulnerability",
        "owasp",
        "auth",
        "secret"
      ],
      "model": "ai-hub-primary",
      "summary": "Security-focused review and remediation."
    },
    "performance-optimizer": {
      "role": "Performance Optimizer",
      "triggers": [
        "performance",
        "bottleneck",
        "memory leak",
        "slow"
      ],
      "model": "ai-hub-primary",
      "summary": "Optimizes runtime, memory and bundle size."
    },
    "build-error-resolver": {
      "role": "Build Fixer",
      "triggers": [
        "build error",
        "compile error",
        "type error",
        "failed build"
      ],
      "model": "ai-hub-primary",
      "summary": "Resolves build and compiler errors."
    },
    "code-simplifier": {
      "role": "Code Simplifier",
      "triggers": [
        "simplify",
        "refine",
        "clean up",
        "clarity"
      ],
      "model": "ai-hub-primary",
      "summary": "Simplifies recently modified code preserving behavior."
    },
    "code-explorer": {
      "role": "Code Explorer",
      "triggers": [
        "explore",
        "understand",
        "find",
        "trace"
      ],
      "model": "ai-hub-primary",
      "summary": "Deep-dive existing features and execution paths."
    },
    "planner": {
      "role": "Planner",
      "triggers": [
        "plan",
        "planning",
        "complex feature",
        "refactor plan"
      ],
      "model": "ai-hub-primary",
      "summary": "Complex feature and refactoring planning."
    },
    "tdd-guide": {
      "role": "TDD Guide",
      "triggers": [
        "tdd",
        "test first",
        "coverage",
        "write tests"
      ],
      "model": "ai-hub-primary",
      "summary": "Enforces test-driven development."
    },
    "silent-failure-hunter": {
      "role": "Silent Failure Hunter",
      "triggers": [
        "silent failure",
        "swallowed error",
        "fallback bug"
      ],
      "model": "ai-hub-primary",
      "summary": "Finds swallowed errors and bad fallbacks."
    },
    "python-reviewer": {
      "role": "Python Reviewer",
      "triggers": [
        "python review",
        "pep8",
        "mypy",
