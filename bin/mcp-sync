#!/usr/bin/env bash
# mcp-sync - synchronize MCP server configs from the canonical registry.

set -euo pipefail

REGISTRY="${HOME}/.agents/mcp/servers.json"
GENERATED_DIR="${HOME}/.agents/mcp/generated"
FILTER="${HOME}/.agents/mcp/filter.jq"
ERRORS=0
DRY_RUN=false
TARGET_AGENT=""

error() { echo "  [ERROR] $1" >&2; ERRORS=$((ERRORS + 1)); }
ok() { echo "  [OK]    $1"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --agent) TARGET_AGENT="$2"; shift 2 ;;
        *) error "Unknown option: $1"; exit 1 ;;
    esac
done

[[ -f "$REGISTRY" ]] || { error "Registry not found: $REGISTRY"; exit 1; }
mkdir -p "$GENERATED_DIR"

write_output() {
    local out="$1"
    local tmp="$2"

    if $DRY_RUN; then
        if [[ ! -f "$out" ]] || ! cmp -s "$tmp" "$out"; then
            error "Generated config drift: $out"
        else
            ok "Generated config converged: $out"
        fi
        rm -f -- "$tmp"
    else
        mv "$tmp" "$out"
        ok "Generated: $out"
    fi
}

generate_json() {
    local agent="$1"
    local out="$2"
    local root="${3:-mcpServers}"
    local tmp
    tmp=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")
    jq --arg agent "$agent" --arg root "$root" -f "$FILTER" "$REGISTRY" > "$tmp"
    write_output "$out" "$tmp"
}

generate_codex() {
    local out="$GENERATED_DIR/config.codex.toml"
    local tmp trimmed sections source base skip line name args env_keys key value cwd type url command bearer oauth_client_id oauth_resource
    tmp=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")
    sections=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")
    base="${HOME}/.agents/mcp/codex-base.toml"
    if [[ -f "$base" ]]; then
        source="$base"
    else
        source="${HOME}/.codex/config.toml"
    fi

    {
        echo "# Generated by mcp-sync from $REGISTRY"
        echo "# Do not edit manually; run: mcp-sync"
        echo ""
        while IFS= read -r name; do
            type=$(jq -r --arg n "$name" '.[$n].type // "stdio"' "$REGISTRY")
            echo "[mcp_servers.$name]"
            if [[ "$type" == "http" ]]; then
                url=$(jq -r --arg n "$name" '.[$n].url // empty' "$REGISTRY")
                if [[ -z "$url" ]]; then
                    error "Active HTTP MCP server '$name' is missing url"
                    continue
                fi
                echo "url = \"$url\""
                bearer=$(jq -r --arg n "$name" '.[$n].bearer_token_env_var // empty' "$REGISTRY")
                [[ -z "$bearer" ]] || echo "bearer_token_env_var = \"$bearer\""
                oauth_client_id=$(jq -r --arg n "$name" '.[$n].oauth_client_id // empty' "$REGISTRY")
                [[ -z "$oauth_client_id" ]] || echo "oauth_client_id = \"$oauth_client_id\""
                oauth_resource=$(jq -r --arg n "$name" '.[$n].oauth_resource // empty' "$REGISTRY")
                [[ -z "$oauth_resource" ]] || echo "oauth_resource = \"$oauth_resource\""
            else
                command=$(jq -r --arg n "$name" '.[$n].command // empty' "$REGISTRY")
                if [[ -z "$command" ]]; then
                    error "Active stdio MCP server '$name' is missing command"
                    continue
                fi
                echo "command = \"$command\""
                args=$(jq -c --arg n "$name" '.[$n].args // []' "$REGISTRY")
                echo "args = $args"
                env_keys=$(jq -r --arg n "$name" '.[$n].env // {} | keys[]?' "$REGISTRY")
                if [[ -n "$env_keys" ]]; then
                    echo ""
                    echo "[mcp_servers.$name.env]"
                    while IFS= read -r key; do
                        [[ -n "$key" ]] || continue
                        value=$(jq -r --arg n "$name" --arg k "$key" '.[$n].env[$k]' "$REGISTRY")
                        echo "$key = \"$value\""
                    done <<< "$env_keys"
                fi
                cwd=$(jq -r --arg n "$name" '.[$n].cwd // empty' "$REGISTRY")
                [[ -z "$cwd" ]] || echo "cwd = \"$cwd\""
            fi
            echo ""
        done < <(
            jq -r --arg agent codex '
              to_entries[]
              | select(.key | startswith("_") | not)
              | select((.value.source // "") != "ecc")
              | select((.value | if type == "object" and has("enabled") then .enabled else true end) == true)
              | select((.value.compatibility // []) | index($agent))
              | .key
            ' "$REGISTRY"
        )
    } > "$sections"

    if [[ -f "$source" ]]; then
        skip=false
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" == "# Generated by mcp-sync from "* || "$line" == "# Do not edit manually; run: mcp-sync" ]]; then
                continue
            fi
            if [[ "$line" == \[* ]]; then
                if [[ "$line" == "[mcp_servers."* || "$line" == *".ai-hub"* ]]; then
                    skip=true
                    continue
                fi
                skip=false
            fi
            $skip || printf '%s\n' "$line"
        done < "$source" > "$tmp"
        trimmed=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")
        awk '{ lines[NR] = $0; if ($0 !~ /^[[:space:]]*$/) last = NR } END { for (i = 1; i <= last; i++) print lines[i] }' "$tmp" > "$trimmed"
        mv "$trimmed" "$tmp"
        printf '\n' >> "$tmp"
        cat "$sections" >> "$tmp"
        rm -f -- "$sections"
    else
        mv "$sections" "$tmp"
    fi

    write_output "$out" "$tmp"
}

generate_gemini_full() {
    local out="$GENERATED_DIR/settings.gemini.json"
    local current="${HOME}/.gemini/settings.json"
    local mcp tmp
    mcp=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")
    tmp=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")
    jq --arg agent gemini --arg root mcpServers -f "$FILTER" "$REGISTRY" > "$mcp"

    if [[ -f "$current" ]]; then
        jq -s '
          .[0] as $current
          | .[1] as $generated
          | ($current * $generated)
          | .mcpServers = $generated.mcpServers
          | .hooks = {
              "PreCompress": [
                {
                  "matcher": "",
                  "hooks": [
                    {
                      "command": "bd prime",
                      "type": "command"
                    }
                  ]
                }
              ],
              "SessionStart": [
                {
                  "hooks": [
                    {
                      "command": "bash \"$HOME/.agents/hooks/session-init.sh\"",
                      "type": "command"
                    }
                  ]
                },
                {
                  "matcher": "",
                  "hooks": [
                    {
                      "command": "bd prime",
                      "type": "command"
                    }
                  ]
                }
              ]
            }
          | .tools.enableHooks = true
        ' "$current" "$mcp" > "$tmp"
        rm -f -- "$mcp"
    else
        mv "$mcp" "$tmp"
    fi

    write_output "$out" "$tmp"
}

generate_aider_yaml() {
    local out="$GENERATED_DIR/.aider.mcp.yml"
    local tmp name args env_keys key value
    tmp=$(mktemp "$GENERATED_DIR/.mcp-sync.XXXXXX")

    {
        echo "# Generated by mcp-sync from $REGISTRY"
        echo "bridge:"
        echo "  enabled: true"
        echo "  port: 8765"
        echo "  host: \"127.0.0.1\""
        echo ""
        echo "servers:"
        while IFS= read -r name; do
            echo "  $name:"
            echo "    command: \"$(jq -r --arg n "$name" '.[$n].command' "$REGISTRY")\""
            echo "    args:"
            while IFS= read -r arg; do
                echo "      - \"$arg\""
            done < <(jq -r --arg n "$name" '.[$n].args // [] | .[]' "$REGISTRY")
            env_keys=$(jq -r --arg n "$name" '.[$n].env // {} | keys[]?' "$REGISTRY")
            if [[ -n "$env_keys" ]]; then
                echo "    env:"
                while IFS= read -r key; do
                    [[ -n "$key" ]] || continue
                    value=$(jq -r --arg n "$name" --arg k "$key" '.[$n].env[$k]' "$REGISTRY")
                    echo "      $key: \"$value\""
                done <<< "$env_keys"
            fi
        done < <(
            jq -r --arg agent aider '
              to_entries[]
              | select(.key | startswith("_") | not)
              | select((.value.source // "") != "ecc")
              | select((.value | if type == "object" and has("enabled") then .enabled else true end) == true)
              | select((.value.compatibility // []) | index($agent))
              | .key
            ' "$REGISTRY"
        )
    } > "$tmp"

    write_output "$out" "$tmp"
}

generate_agent() {
    case "$1" in
        claude) generate_json claude "$GENERATED_DIR/.mcp.json" ;;
        kimi) generate_json kimi "$GENERATED_DIR/kimi.mcp.json" ;;
        gemini) generate_gemini_full ;;
        cursor) generate_json cursor "$GENERATED_DIR/mcp.cursor.json" ;;
        vscode) generate_json cursor "$GENERATED_DIR/mcp.vscode.json" servers ;;
        opencode) generate_json opencode "$GENERATED_DIR/opencode.mcp.json" ;;
        aider) generate_aider_yaml ;;
        codex) generate_codex ;;
        shared) generate_json codex "${HOME}/.agents/mcp/shared-mcp.json" ;;
        *) error "Unknown agent: $1"; return ;;
    esac
}

echo "=== MCP Sync ==="
echo "Registry: $REGISTRY"
echo ""

if [[ -n "$TARGET_AGENT" ]]; then
    generate_agent "$TARGET_AGENT"
else
    for agent in claude kimi gemini cursor vscode opencode aider codex shared; do
        generate_agent "$agent"
    done
fi

echo ""
if [[ "$ERRORS" -eq 0 ]]; then
    echo "All requested MCP configs generated."
else
    echo "Completed with $ERRORS error(s)."
fi
exit "$ERRORS"
