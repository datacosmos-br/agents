#!/usr/bin/env python3
"""Load the user's environment.d modules consistently across shells."""

from __future__ import annotations

import argparse
import os
import re
import shlex
import sys
import tomllib
from pathlib import Path

CONFIG_ROOT = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
ENV_ROOT = CONFIG_ROOT / "environment.d"
NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
SECRET_NAME_RE = re.compile(
    r"(?:^|_)(?:TOKEN|PASSWORD|SECRET|API_KEY|PRIVATE_KEY)$", re.IGNORECASE
)
REF_RE = re.compile(
    r"\$(?P<plain>[A-Za-z_][A-Za-z0-9_]*)|"
    r"\$\{(?P<braced>[A-Za-z_][A-Za-z0-9_]*)(?:(?P<op>:-|:\+)(?P<arg>[^}]*))?\}"
)


def expand(value: str, values: dict[str, str]) -> str:
    def replace(match: re.Match[str]) -> str:
        name = match.group("plain") or match.group("braced")
        current = values.get(name, "")
        operation = match.group("op")
        argument = match.group("arg") or ""
        if operation == ":-":
            return current or expand(argument, values)
        if operation == ":+":
            return expand(argument, values) if current else ""
        return current

    # environment.d expands references against the values that existed before
    # this assignment. Do one substitution pass so an inherited literal such
    # as "$LD_LIBRARY_PATH" cannot recursively expand forever.
    return REF_RE.sub(replace, value)


def unquote(value: str, path: Path, line_number: int) -> str:
    value = value.strip()
    if not value:
        return ""
    if value[0] in "'\"":
        if len(value) < 2 or value[-1] != value[0]:
            raise ValueError(f"{path}:{line_number}: unmatched quote")
        value = value[1:-1]
    if "`" in value or "$(" in value or "\n" in value or "\r" in value:
        raise ValueError(f"{path}:{line_number}: executable syntax is forbidden")
    return value


def load_environment() -> dict[str, str]:
    values = dict(os.environ)
    managed: dict[str, str] = {}
    for path in sorted(ENV_ROOT.glob("*.conf")):
        for line_number, raw in enumerate(
            path.read_text(encoding="utf-8").splitlines(), 1
        ):
            line = raw.strip()
            if not line or line.startswith(("#", ";")):
                continue
            if "=" not in line:
                raise ValueError(f"{path}:{line_number}: expected KEY=VALUE")
            name, raw_value = line.split("=", 1)
            name = name.strip()
            if not NAME_RE.fullmatch(name):
                raise ValueError(f"{path}:{line_number}: invalid variable name")
            value = expand(unquote(raw_value, path, line_number), values)
            values[name] = value
            managed[name] = value
    return managed


def emit_environment(shell: str, *, preserve_inherited_path: bool = False) -> None:
    for name, value in load_environment().items():
        if preserve_inherited_path and name == "PATH":
            continue
        quoted = shlex.quote(value)
        if shell in {"bash", "zsh"}:
            print(f"export {name}={quoted}")
        else:
            print(f"set -gx {name} {quoted}")


def emit_secret_cleanup(shell: str) -> None:
    """Remove inherited secrets before resolving any shell tool or shim."""
    path = ENV_ROOT / "secrets" / "profiles.toml"
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    declared = {
        name
        for profile in data.get("profiles", {}).values()
        for name in (
            *profile.get("variables", []),
            *profile.get("aliases", {}).keys(),
        )
        if isinstance(name, str) and NAME_RE.fullmatch(name)
    }
    names = sorted(
        declared | {"DIRENV_DIFF", "DIRENV_DIR", "DIRENV_FILE", "DIRENV_WATCHES"}
    )
    if shell in {"bash", "zsh"}:
        if names:
            print("unset " + " ".join(names))
    else:
        for name in names:
            print(f"set -e {name}")


def emit_aliases(shell: str) -> None:
    path = ENV_ROOT / "shell" / "aliases.toml"
    aliases = tomllib.loads(path.read_text(encoding="utf-8")).get("aliases", {})
    for name, command in aliases.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or not isinstance(command, str):
            raise ValueError(f"{path}: invalid alias")
        print(f"alias {name}={shlex.quote(expand(command, dict(os.environ)))}")


def emit_completions(shell: str) -> None:
    path = ENV_ROOT / "shell" / "completions.toml"
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    for candidate in data.get(shell, {}).get("source", []):
        expanded = Path(expand(str(candidate), dict(os.environ))).expanduser()
        if expanded.is_file():
            print(f"source {shlex.quote(str(expanded))}")


def validate_environment() -> None:
    """Validate the machine-local authority without knowing its variables."""
    managed = load_environment()
    secret_names = sorted(name for name in managed if SECRET_NAME_RE.search(name))
    if secret_names:
        raise ValueError(
            "secret-like variables are forbidden in environment.d: "
            + ", ".join(secret_names)
        )
    path = managed.get("PATH")
    if path:
        entries = path.split(":")
        duplicates = sorted({entry for entry in entries if entries.count(entry) > 1})
        if duplicates:
            raise ValueError(
                "PATH contains duplicate entries: " + ", ".join(duplicates)
            )
    for name in ("TMPDIR", "GOTMPDIR"):
        value = managed.get(name)
        if value and (not Path(value).is_absolute() or Path(value) == Path("/tmp")):
            raise ValueError(f"{name} must be absolute and must not equal /tmp")
    aliases_path = ENV_ROOT / "shell" / "aliases.toml"
    aliases = tomllib.loads(aliases_path.read_text(encoding="utf-8")).get("aliases", {})
    if not isinstance(aliases, dict) or any(
        not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or not isinstance(command, str)
        for name, command in aliases.items()
    ):
        raise ValueError(f"{aliases_path}: invalid alias table")
    completions_path = ENV_ROOT / "shell" / "completions.toml"
    completions = tomllib.loads(completions_path.read_text(encoding="utf-8"))
    for shell in ("bash", "zsh", "fish"):
        sources = completions.get(shell, {}).get("source", [])
        if not isinstance(sources, list) or any(
            not isinstance(candidate, str) for candidate in sources
        ):
            raise ValueError(f"{completions_path}: invalid {shell} completions")


def emit_bootstrap(shell: str, interactive: bool) -> None:
    """Emit the non-secret shell baseline.

    Directory-scoped credentials are owned by direnv.  Loading them here makes
    a shell permanently retain the credentials from its initial directory and
    lets stale values override the credential stores used by tools such as
    mise and gh.
    """
    emit_secret_cleanup(shell)
    # BASH_ENV is evaluated for every non-interactive child Bash. Replacing
    # PATH there defeats an explicit PATH supplied by the parent (including
    # test fixtures and hermetic tool runners). Interactive shells establish
    # the canonical baseline; their children inherit it unchanged.
    emit_environment(shell, preserve_inherited_path=not interactive)
    if interactive:
        emit_aliases(shell)
        emit_completions(shell)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "surface",
        choices=(
            "bootstrap",
            "clear-secrets",
            "env",
            "aliases",
            "completions",
            "validate",
        ),
    )
    parser.add_argument("--shell", required=True, choices=("bash", "zsh", "fish"))
    parser.add_argument("--interactive", action="store_true")
    args = parser.parse_args()
    try:
        if args.surface == "bootstrap":
            emit_bootstrap(args.shell, args.interactive)
        elif args.surface == "clear-secrets":
            emit_secret_cleanup(args.shell)
        elif args.surface == "env":
            emit_environment(args.shell)
        elif args.surface == "aliases":
            emit_aliases(args.shell)
        elif args.surface == "completions":
            emit_completions(args.shell)
        else:
            validate_environment()
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"environment-d-loader: {error}", file=sys.stderr)
        return 78
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
