#!/usr/bin/env python3
"""Load the user's environment.d modules consistently across shells."""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
import tomllib
from pathlib import Path


CONFIG_ROOT = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
ENV_ROOT = CONFIG_ROOT / "environment.d"
NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
REF_RE = re.compile(
    r"\$(?P<plain>[A-Za-z_][A-Za-z0-9_]*)|"
    r"\$\{(?P<braced>[A-Za-z_][A-Za-z0-9_]*)(?:(?P<op>:-|:\+)(?P<arg>[^}]*))?\}"
)


def expand(value: str, values: dict[str, str]) -> str:
    def replace(match: re.Match[str]) -> str:
        name = match.group("plain") or match.group("braced")
        current = values.get(name, "")
        operation = match.group("op")
        argument = match.group("arg") or ""
        if operation == ":-":
            return current or expand(argument, values)
        if operation == ":+":
            return expand(argument, values) if current else ""
        return current

    # environment.d expands references against the values that existed before
    # this assignment. Do one substitution pass so an inherited literal such
    # as "$LD_LIBRARY_PATH" cannot recursively expand forever.
    return REF_RE.sub(replace, value)


def unquote(value: str, path: Path, line_number: int) -> str:
    value = value.strip()
    if not value:
        return ""
    if value[0] in "'\"":
        if len(value) < 2 or value[-1] != value[0]:
            raise ValueError(f"{path}:{line_number}: unmatched quote")
        value = value[1:-1]
    if "`" in value or "$(" in value or "\n" in value or "\r" in value:
        raise ValueError(f"{path}:{line_number}: executable syntax is forbidden")
    return value


def load_environment() -> dict[str, str]:
    values = dict(os.environ)
    managed: dict[str, str] = {}
    for path in sorted(ENV_ROOT.glob("*.conf")):
        for line_number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            line = raw.strip()
            if not line or line.startswith(("#", ";")):
                continue
            if "=" not in line:
                raise ValueError(f"{path}:{line_number}: expected KEY=VALUE")
            name, raw_value = line.split("=", 1)
            name = name.strip()
            if not NAME_RE.fullmatch(name):
                raise ValueError(f"{path}:{line_number}: invalid variable name")
            value = expand(unquote(raw_value, path, line_number), values)
            values[name] = value
            managed[name] = value
    return managed


def emit_environment(shell: str) -> None:
    for name, value in load_environment().items():
        quoted = shlex.quote(value)
        if shell in {"bash", "zsh"}:
            print(f"export {name}={quoted}")
        else:
            print(f"set -gx {name} {quoted}")


def emit_secret_cleanup(shell: str) -> None:
    """Remove inherited secrets before resolving any shell tool or shim."""
    path = ENV_ROOT / "secrets" / "profiles.toml"
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    names = sorted(
        {
            name
            for profile in data.get("profiles", {}).values()
            for name in profile.get("variables", [])
            if isinstance(name, str) and NAME_RE.fullmatch(name)
        }
        | {"DIRENV_DIFF", "DIRENV_DIR", "DIRENV_FILE", "DIRENV_WATCHES"}
    )
    if shell in {"bash", "zsh"}:
        if names:
            print("unset " + " ".join(names))
    else:
        for name in names:
            print(f"set -e {name}")


def emit_aliases(shell: str) -> None:
    path = ENV_ROOT / "shell" / "aliases.toml"
    aliases = tomllib.loads(path.read_text(encoding="utf-8")).get("aliases", {})
    for name, command in aliases.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name) or not isinstance(command, str):
            raise ValueError(f"{path}: invalid alias")
        print(f"alias {name}={shlex.quote(command)}")


def emit_completions(shell: str) -> None:
    path = ENV_ROOT / "shell" / "completions.toml"
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    for candidate in data.get(shell, {}).get("source", []):
        expanded = Path(expand(str(candidate), dict(os.environ))).expanduser()
        if expanded.is_file():
            print(f"source {shlex.quote(str(expanded))}")


def emit_keyring(shell: str) -> None:
    """Load the directory-authorized automatic profile from Secret Service."""
    executable = Path.home() / ".local" / "bin" / "env-keyring"
    if not executable.is_file():
        raise OSError(f"keyring loader missing: {executable}")
    process = subprocess.run(
        [str(executable), "auto-shell", "--directory", os.getcwd(), "--shell", shell],
        check=False,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if process.returncode != 0:
        raise OSError(process.stderr.strip() or "keyring profile load failed")
    print(process.stdout, end="")


def emit_bootstrap(shell: str, interactive: bool) -> None:
    """Emit one complete shell bootstrap without repeated Python startups."""
    emit_secret_cleanup(shell)
    emit_environment(shell)
    emit_keyring(shell)
    if interactive:
        emit_aliases(shell)
        emit_completions(shell)
def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "surface",
        choices=("bootstrap", "clear-secrets", "env", "aliases", "completions"),
    )
    parser.add_argument("--shell", required=True, choices=("bash", "zsh", "fish"))
    parser.add_argument("--interactive", action="store_true")
    args = parser.parse_args()
    try:
        if args.surface == "bootstrap":
            emit_bootstrap(args.shell, args.interactive)
        elif args.surface == "clear-secrets":
            emit_secret_cleanup(args.shell)
        elif args.surface == "env":
            emit_environment(args.shell)
        elif args.surface == "aliases":
            emit_aliases(args.shell)
        else:
            emit_completions(args.shell)
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"environment-d-loader: {error}", file=sys.stderr)
        return 78
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
