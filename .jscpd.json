{
  "//": "Agents-owned strict duplication gate for canonical Python runtime source.",
  "absolute": true,
  "no-tips": true,
  "no-colors": true, 
  "mode": "strict",
  "ignore": [
    "**/__pycache__/**",
    "**/target/**",
    "**/*.pyc",
    "**/*.bak",
    "**/*.tmp",
    "**/*.orig",
    "**/.venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.eggs/**",
    "**/__init__.py",
    "**/.github/**",
    "**/.claude/**",
    "**/.agents/**",
    "**/.cursor/**",
    "**/.codex/**",
    "**/skills/**",
    "Makefile",
    "LICENSE.md"
  ],
  "reporters": ["console"],
  "min-lines": 8
}
