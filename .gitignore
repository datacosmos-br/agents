.env.local
/.venv/
/dist/*
!/dist/.gitignore

# Python and tool artifacts are normal disposable caches. Repository discovery
# and cleanliness use Git ignore semantics instead of disabling or deleting them.
**/__pycache__/
**/*.py[cod]
.mypy_cache/
.eggs/
.pytest-scratch/
.pytest_cache/
.ruff_cache/
.test-tmp/
.testmondata
.waza-cache/
.reports/
build/
htmlcov/
node_modules/
results/
target/
*.egg-info/

# AI Hub owns provider/runtime materialization. These paths are never semantic
# package input and every generated file must carry the managed-by marker with
# the bundle version (ADR-0015); markerless or version-drifted files are swept.
/.agents/
/.claude/
/.codex/
/.cursor/
/.gemini/
/.opencode/
/.github/agents/
/.github/hooks/
/.github/instructions/
/.github/skills/
/GEMINI.md

# Banned residue (never source, any profile): deploy-transaction prior state,
# staging names, and ad-hoc backups are runtime-only and must never be tracked.
*aihub-prior*
*aihub-txn*
*.pre-fleet-*

# Gas City and the selected tracker own their suspended runtime state.
/.gc/
/crew/
/polecats/
/worktrees/
/.dolt/
/.beads/*
!/.beads/identity.toml
*.db
.beads-credential-key
.gqlout.json
.poolside/
backup/
