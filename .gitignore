.env.local
/.venv/
/dist/*
!/dist/.gitignore

# AI Hub owns provider/runtime materialization. These paths are never semantic
# package input and every generated file must carry the AI Hub owner marker.
/.agents/
/.claude/
/.codex/
/.cursor/
/.gemini/
/.opencode/
/.github/agents/
/.github/hooks/
/.github/instructions/
/.github/skills/
/GEMINI.md

# Gas City and the selected tracker own their suspended runtime state.
/.gc/
/crew/
/polecats/
/worktrees/
/.dolt/
/.beads/*
!/.beads/identity.toml
*.db
.beads-credential-key
.gqlout.json
.poolside/
